{
  "name": "stemforge-configurator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "StemForge Configurator popup — React + shadcn/ui + Framer Motion.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:deploy": "npm run build && rsync -a dist/ ../../stemforge/configurator/static/",
